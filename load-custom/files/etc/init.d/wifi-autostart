#!/bin/sh /etc/rc.common

START=99

start() {
    # Wait for USB WiFi to be detected
    sleep 5

    # Load module if not already loaded
    if ! lsmod | grep -q rtl8xxxu; then
        modprobe rtl8xxxu 2>/dev/null
        sleep 3
    fi

    # Only reload wifi config, do NOT override user settings
    wifi reload
}

stop() {
    wifi reload
}